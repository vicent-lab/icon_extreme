---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="wrap" style="padding:96px 32px;text-align:center">
    <h1 style="font-size:40px;font-weight:800">We could not find that page.</h1>
    <p style="color:var(--muted)">It may have moved. Start again from the home page.</p>
    <p><a class="btn btn-ink" href="/">Go to the home page</a></p>
  </div>
</Base>
